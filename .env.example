# Copia este archivo como .env.local y rellena los valores de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → App web → Configuración del SDK).
# .env.local no se sube a git. Si se deja vacío, la app funciona en modo local sin cuentas.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
